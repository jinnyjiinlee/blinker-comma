<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- 디버그 빌드 전용 시연 주입 — VC로 못 넣는 신호만. DUMP 권한 = adb 셸만 보낼 수 있음(다른 앱 차단) -->
        <receiver
            android:name=".debug.DemoInjectReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.blinkercomma.debug.INJECT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
