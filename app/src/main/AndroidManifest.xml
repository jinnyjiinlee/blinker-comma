<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- 차 신호는 읽기만(제어 CONTROL_* 0개 — 설계서 원칙 2). 최소 집합 실측은 docs/signals_measured.md -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 속도만 Dangerous — 첫 실행 P 화면에서 1회 허용(거부해도 레버 + D로 동작, 원칙 4) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BlinkerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- 주행 중에도 떠 있는 앱(D 화면은 쉼표 표시 하나뿐, 조작은 P에서만) — AAOS 주의 분산 최적화 선언 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pleos Music/Audio 앱 필수 요건 — MediaBrowserService. 연결돼도 재생은 시작하지 않는다(원칙 5) -->
        <service
            android:name=".service.ReaderService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
